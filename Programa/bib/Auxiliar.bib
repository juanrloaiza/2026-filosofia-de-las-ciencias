@book{Bueter2024,
  title = {Feminist Philosophy of Science},
  author = {Bueter, Anke},
  date = {2024},
  series = {Elements in the Philosophy of Science},
  publisher = {Cambridge University Press},
  location = {Cambridge, United Kingdom ; New York, NY},
  abstract = {"Feminist scholars have identified pervasive gender discrimination in science as an institution, as well as gender bias in the very content of many scientific theories. An ameliorative project at heart, feminist philosophy of science has inquired into the social and epistemological roots and consequences of these problems and into their potential solutions. Most feminist philosophers agree on a need for diversity in scientific communities to counter the detrimental effects of gender bias. Diversity could thus serve as a unifying concept for a potential consensus of the field. Yet there are substantial differences in the kinds and roles of diversity envisaged. This element argues that we need diversity, both in terms of social locations and of values, to overcome former biases and blind spots. Diversity as such, however, is insufficient. To reap its epistemic benefits, diversity also needs to be institutionalised in a way that counters various forms of epistemic injustice"--},
  isbn = {978-1-009-50725-7 978-1-108-95834-9},
  keywords = {Auxiliar}
}

